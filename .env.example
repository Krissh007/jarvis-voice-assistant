# Required: Gemini API key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional: fallback text model when Gemini is overloaded (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Optional: better web search (https://tavily.com); without it JARVIS uses DuckDuckGo
TAVILY_API_KEY=

# Optional: bearer token for the local Agent Hub (the same value as HUB_TOKEN in the Hub's .env)
AGENT_HUB_TOKEN=
